# Copy this file to .env and fill in your own values.
# .env is ignored by git and must never be committed. This example file is
# public, so it holds placeholders only.

# --- Public by design -------------------------------------------------------
# The browser needs these two to send a waitlist sign-up, so they end up in
# js/config.js, which is public. That is safe: the table only allows adding
# rows (see supabase/waitlist.sql). Copy them across with:
#   node scripts/apply-env.js
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# --- Private: never leaves this file -----------------------------------------
# Nothing in the website uses these. Leave them blank unless you need them for
# your own admin work (for example exporting the waitlist from a script).
# The secret key can read and delete every row, so treat it like a password.
SUPABASE_SECRET_KEY=
SUPABASE_DB_PASSWORD=
