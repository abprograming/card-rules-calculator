# Secrets: real values live in .env, which must never be committed.
# .env.example holds placeholders only and is the one env file that is tracked.
.env
.env.*
!.env.example

# Operating system and editor files
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# Local Claude settings (launch.json is kept so the preview server works)
.claude/settings.local.json

# Node, in case tooling is added later
node_modules/
